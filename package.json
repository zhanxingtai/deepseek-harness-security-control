{
  "name": "sst-security-control-dsh",
  "description": "DeepSeek Harness security monitoring and runtime intervention plugin",
  "version": "1.0.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "!lib/types/types/**",
    "lib/marketplace.manifest.json",
    "locale/en.json",
    "locale/zh.json",
    "assets/logo.png",
    "assets/logo.ico",
    "assets/wechat-mp-qr.jpg",
    "policies/**/*.yaml",
    "policies/**/*.json",
    "scripts/inspect-events.mjs",
    "scripts/check-readme-sync.mjs",
    "scripts/stress-spl-interactive.mjs",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "security",
    "spl",
    "intervention",
    "agent-governance",
    "runtime-hook",
    "sensitive-path-guard",
    "prompt-injection-guard"
  ],
  "icon": "assets/logo.png",
  "author": {
    "name": "sst-security-control-dsh contributors",
    "email": "support@zhihuizhanxing.com",
    "url": "https://github.com/zhanxingtai/deepseek-harness-security-control"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && node scripts/build-client.mjs",
    "build:host": "tsc -b tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "clean": "rm -rf lib",
    "pretest": "pnpm build",
    "test": "vitest run",
    "prepare:marketplace": "node scripts/prepare.mjs",
    "verify:self-contained": "node scripts/verify-self-contained.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "verify:readme-sync": "node scripts/check-readme-sync.mjs",
    "verify:action-type-producers": "node scripts/verify-action-type-producers.mjs",
    "verify:spl-block-code": "node scripts/verify-spl-block-code-detector.mjs",
    "verify:test-cases-coverage": "node scripts/verify-test-cases-coverage.mjs",
    "verify:self-protection": "bash scripts/verify-self-protection.sh",
    "verify": "pnpm run verify:self-contained && pnpm run verify:artifacts && pnpm run verify:readme-sync && pnpm run verify:action-type-producers && pnpm run verify:spl-block-code && pnpm run verify:test-cases-coverage && pnpm run verify:self-protection",
    "prepack": "node scripts/prepare.mjs && node scripts/verify-self-contained.mjs && node scripts/verify-artifacts.mjs && node scripts/check-readme-sync.mjs && node scripts/verify-action-type-producers.mjs && node scripts/verify-spl-block-code-detector.mjs && node scripts/verify-test-cases-coverage.mjs && bash scripts/verify-self-protection.sh",
    "pack": "npm pack --pack-destination install",
    "install-dev": "node scripts/install-dev.mjs",
    "inspect-events": "node scripts/inspect-events.mjs",
    "stress:spl": "node scripts/stress-spl-interactive.mjs",
    "dev:reinstall": "node scripts/dev-reinstall.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.0.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.6-alpha.2 <0.3.0",
    "yaml": ">=2.5.0 <3.0.0",
    "js-yaml": "^5.0.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-commands": ">=0.1.5-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.6-alpha.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "yaml": {
      "optional": true
    },
    "js-yaml": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "ajv": "^8.17.1",
    "esbuild": "^0.21.5",
    "js-yaml": "^5.4.2",
    "yaml": "^2.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.0",
    "happy-dom": "^15.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "entry": "lib/index.js",
      "schemaVersion": 1,
      "cordisVersion": ">=4"
    },
    "client": {
      "platform": "web",
      "entry": "lib/client.js",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dshWorkshop": {
    "name": "sst-security-control-dsh",
    "permissions": [
      "network:none"
    ],
    "minHarnessVersion": "0.4.0",
    "compatibility": {
      "dshVersions": ">=0.4.0 <1.0.0",
      "cordisVersions": ">=4.0.0 <5.0.0",
      "nodeVersions": "^22.19.0 || >=24.0.0"
    }
  },
  "marketplace": {
    "category": "security-monitoring",
    "tier": "community",
    "owner": "sst-security-control-dsh-contributors",
    "capabilities": [
      "intercept.tool_call",
      "intercept.message_write",
      "intercept.agent_run",
      "collect.application",
      "collect.network_http",
      "collect.network_dns",
      "collect.process_spawn",
      "collect.process_resolve",
      "rpc.security.status",
      "rpc.security.recent",
      "rpc.security.rules",
      "rpc.security.reload"
    ],
    "supportChannels": {
      "issues": "https://github.com/zhanxingtai/deepseek-harness-security-control/issues",
      "docs": "https://github.com/zhanxingtai/deepseek-harness-security-control#readme",
      "discussion": "https://github.com/zhanxingtai/deepseek-harness-security-control/discussions"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhanxingtai/deepseek-harness-security-control.git"
  },
  "bugs": {
    "url": "https://github.com/zhanxingtai/deepseek-harness-security-control/issues"
  },
  "homepage": "https://github.com/zhanxingtai/deepseek-harness-security-control"
}
