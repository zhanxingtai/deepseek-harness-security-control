# MUST stay in sync with `settings.autoInstallPeers` in pnpm-lock.yaml.
# On `install --frozen-lockfile` pnpm compares the two and aborts with
# ERR_PNPM_LOCKFILE_CONFIG_MISMATCH before fetching anything, so a drift
# here fails the whole CI build. The lockfile is authoritative: it records
# `true` (pnpm 10's default), which is the setting the locked dependency
# tree was actually resolved and tested under.
auto-install-peers=true
# 2026-09-19: pin pnpm to 10.x (CI workflow + local dev). pnpm 11+ runs
# metadata-only fetches for peer dependencies during install; the
# @deepseek-ai/* peer deps sit outside the pnpm-10 happy path and pnpm 11
# can return ERR_PNPM_FETCH_404 even with strict-peer-dependencies=false
# (pnpm/pnpm#9490). strict-peer-dependencies=false is set here as
# belt-and-suspenders: a no-op on pnpm 10, but it makes pnpm 11 emit
# warnings instead of errors when this project eventually upgrades.
#
# 2026-10-21: this note used to claim @deepseek-ai/* are private packages
# absent from registry.npmjs.org. No longer true — `npm view
# @deepseek-ai/cordis version` resolves against the public registry. The
# pnpm 10 pin is kept as a precaution.
strict-peer-dependencies=false
# 2026-09-27: esbuild postinstall allowlist lives in pnpm-workspace.yaml
# (`allowBuilds: { esbuild: true }`). pnpm 12 stopped reading
# `pnpm.onlyBuiltDependencies` from package.json and the
# `only-built-dependencies[]=` form from .npmrc; the YAML file is the
# canonical location and persists for other devs / CI.