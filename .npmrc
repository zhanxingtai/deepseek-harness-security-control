auto-install-peers=false
# 2026-09-19: pin pnpm to 10.x (CI workflow + local dev). pnpm 11+ runs
# metadata-only fetches for peer dependencies during install; the
# @deepseek-ai/* peer deps are private npm packages (not on
# registry.npmjs.org) and pnpm 11 returns ERR_PNPM_FETCH_404 even with
# strict-peer-dependencies=false (pnpm/pnpm#9490, fix incomplete for
# "scope not on registry" cases). strict-peer-dependencies=false is set
# here as belt-and-suspenders: it's a no-op on pnpm 10 with
# auto-install-peers=false but makes pnpm 11 emit warnings instead of
# errors when this project eventually upgrades.
strict-peer-dependencies=false
# 2026-09-27: esbuild postinstall allowlist lives in pnpm-workspace.yaml
# (`allowBuilds: { esbuild: true }`). pnpm 12 stopped reading
# `pnpm.onlyBuiltDependencies` from package.json and the
# `only-built-dependencies[]=` form from .npmrc; the YAML file is the
# canonical location and persists for other devs / CI.