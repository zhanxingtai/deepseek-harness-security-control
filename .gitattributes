# Shell scripts must be LF on every platform: they're executed on Linux
# targets, and a CRLF working tree (core.autocrlf=true on Windows) breaks
# the shebang (`/usr/bin/env: 'bash\r'`).  The install bundle copies
# install.sh byte-for-byte (scripts/build-install.mjs), so the blob's LF
# must survive checkout.
*.sh text eol=lf
*.ps1 text eol=crlf

# 2026-10-21 oss-prep: TS sources and vitest snapshots stay LF on every
# platform. Without an explicit rule, Windows checkouts with
# `core.autocrlf=true` silently flip LF → CRLF on stash/pull, leaving
# phantom `M` entries with empty diffs (vitest then complains about
# "stale-looking" line endings on the same files). Pin to LF so the
# working tree matches the index byte-for-byte.
*.ts text eol=lf
*.snap text eol=lf

# JSON and Markdown are pinned for the same reason. `locale/*.json` in
# particular showed a phantom `M` on every branch switch — a clean
# `git diff` alongside a dirty status, which is the signature of the
# autocrlf/index mismatch rather than a real edit. Left unpinned, any
# future README or locale edit risks the same false alarm, and a
# `git add` that stages nothing is easy to misread as "already
# committed". No build artefact is derived from either file's line
# endings, so LF everywhere is safe.
*.json text eol=lf
*.md text eol=lf

# 2026-10-23: these ship BYTE-FOR-BYTE into the marketplace tarball (they
# are in package.json `files` and are copied, not compiled), so their line
# endings are part of the published artefact's identity, not just working-
# tree hygiene. Without a rule, `core.autocrlf=true` on a Windows checkout
# rewrites them to CRLF, and the tarballs uploaded by `windows-package` /
# `macos-package` stop being byte-identical to the ubuntu one that `release`
# actually publishes — three platforms, three different artefacts.
#
# Concrete inventory of what this covers:
#   policies/**/*.yaml  — default-policy.spl.yaml (~256 kB), parsed by the
#                         engine and shipped verbatim
#   cordis.patch.yml    — the marketplace PatchOptions contract
#   *.mjs               — inspect-events / check-readme-sync /
#                         stress-spl-interactive ship as scripts/
#   LICENSE             — extensionless, hence the explicit name
#
# `*.js` is deliberately absent: `lib/` is the tsc outDir and is gitignored,
# so no tracked .js exists and a rule for it would be dead config. The
# shipped `lib/**/*.js` inherits LF from these LF-pinned `*.ts` sources.
*.yaml text eol=lf
*.yml text eol=lf
*.mjs text eol=lf
LICENSE text eol=lf

# git hooks (extensionless) must stay LF: CRLF breaks bash hook execution on Windows
scripts/git-hooks/* text eol=lf
